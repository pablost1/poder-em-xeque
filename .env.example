# Copie para .env.local e ajuste. Nenhuma destas variáveis é segredo.

# Caminho do banco SQLite. Padrão: data/congresso.db
CONGRESSO_DB=data/congresso.db

# 1 = habilita /revisar (revisão de marcações) e a gravação de correções. Use só localmente, nunca em produção pública.
ADMIN=

# Porta do servidor de produção (npm start / node server.js)
PORT=3000
